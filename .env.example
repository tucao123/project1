# ==============================================================================
# RFR · 关系摩擦预演器 MVP — 全局配置模板
# ------------------------------------------------------------------------------
# 用法：复制本文件为 .env（已随项目提供一份可直接运行的默认值），按需修改后
#       重启 dev server / 重新 build 即生效。所有配置都通过 VITE_ 前缀注入。
#
# 约定：
#   · 布尔值用 true / false
#   · 列表用英文逗号 "," 分隔；文案内部请使用中文标点，避免误切分
#   · 正则用 "|" 分隔多个模式，不要写 "#" 和反斜杠转义
#   · 视觉设计令牌（#E4FF00 / #121212 / 28px 圆角 / 字体 / 动画曲线）
#     固化在 src/styles/metamodern.css，不在此处开放，以保证元现代风格不变。
# ==============================================================================

# ------------------------------------------------------------------------------
# 01 · 应用元信息与品牌文案
# ------------------------------------------------------------------------------
VITE_APP_NAME=RFR · 关系摩擦预演器
VITE_APP_VERSION=0.1.0-mvp
VITE_APP_TAGLINE=先预演，再开口
VITE_HERO_LINE_1=Where
VITE_HERO_EM_1=friction
VITE_HERO_LINE_2=meets
VITE_HERO_EM_2=clarity
VITE_HERO_DESC=关系里那些说不清的小摩擦，先在这里试一遍，再想好怎么开口。
VITE_HERO_CTA=开始预演
VITE_WAVE_TITLE=情绪波动
VITE_WAVE_STATUS=实时

# 画作 / 场景图资源（留空或加载失败时自动回退到内置抽象纹理，不影响风格）
VITE_BRAND_IMAGE_URL=https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?q=80&w=1000&auto=format&fit=crop
VITE_SCENE_IMAGE_1_URL=https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=600&auto=format&fit=crop
VITE_SCENE_IMAGE_2_URL=https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?q=80&w=600&auto=format&fit=crop
VITE_SCENE_IMAGE_3_URL=https://images.unsplash.com/photo-1577083552431-6e5fd01aa342?q=80&w=600&auto=format&fit=crop

# ------------------------------------------------------------------------------
# 02 · 视图与切页（幕布动画 / 底部胶囊导航）
# ------------------------------------------------------------------------------
VITE_INITIAL_VIEW=intake
VITE_ENABLED_VIEWS=intake,rehearsal,profile,script,archive,group
VITE_VIEW_LABELS=观察,预演,画像,陪练,档案,群体
VITE_TRANSITION_DURATION_MS=600
VITE_TRANSITION_HOLD_MS=100
VITE_TRANSITION_RELEASE_MS=600

# ------------------------------------------------------------------------------
# 03 · 后端接入（MVP 默认纯前端演示数据，接后端时把 USE_MOCK 改为 false）
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK=true
VITE_SSE_ENABLED=false
VITE_REQUEST_TIMEOUT_MS=15000
VITE_API_INTAKE_PATH=/api/v1/intake
VITE_API_REHEARSAL_PATH=/api/v1/rehearsal
VITE_API_PROFILE_PATH=/api/v1/profile
VITE_API_SCRIPT_PATH=/api/v1/script
VITE_API_FEEDBACK_PATH=/api/v1/feedback

# ------------------------------------------------------------------------------
# 04 · 功能开关
# ------------------------------------------------------------------------------
VITE_ENABLE_B_END=true
VITE_ENABLE_PAID_SCRIPT=true
VITE_ENABLE_ROLE_CARD=true
VITE_ENABLE_EXPORT=true
VITE_ENABLE_DELETE=true
VITE_ENABLE_FEEDBACK=true
VITE_ENABLE_WEEKLY_TREND=true
VITE_ENABLE_COMPLIANCE_BADGE=true
VITE_ENABLE_AGE_GATE=true

# ------------------------------------------------------------------------------
# 05 · 预演流程与固定规则
# ------------------------------------------------------------------------------
# 场景数量：由易到难
VITE_SCENARIO_COUNT=3
VITE_MIN_SCENARIO_COUNT=2
VITE_SCENARIO_INTENSITIES=low,mid,mid-high
# 默认不出太刺激的场景
VITE_ALLOW_HIGH_INTENSITY=false
# 重试次数上限
VITE_MAX_REWRITE=2
VITE_MAX_FREE_TEXT_LENGTH=300
# 选项问「你会怎么做」，不要问「怎么做最好」
VITE_CHOICE_PROMPT=你最可能会怎么做？
# 结果页标题：只描述选择，不贴标签
VITE_PROFILE_TITLE=你的应对方式
VITE_PROFILE_SUBTITLE=只说刚才这几轮你怎么选的，不是给你贴标签。
# 四种应对方式的叫法
VITE_EVLN_LABELS=说出来，好好说,说出来，带点刺,先忍着，等一等,不回应，冷处理
VITE_AXIS_ACTIVE=主动说
VITE_AXIS_PASSIVE=先等等
VITE_AXIS_CONSTRUCTIVE=好好说
VITE_AXIS_DESTRUCTIVE=带情绪
VITE_SCRIPT_TITLE=开口前练一遍
VITE_SCRIPT_SECTION_HINT=一句话怎么说，对方不接怎么办

# ------------------------------------------------------------------------------
# 06 · 商业与定价（PRD §6）
# ------------------------------------------------------------------------------
VITE_CURRENCY_SYMBOL=¥
VITE_SCRIPT_PRICE_CNY=19.9
VITE_SUBSCRIPTION_PRICE_CNY=39

# ------------------------------------------------------------------------------
# 07 · 合规与隐私
# ------------------------------------------------------------------------------
VITE_AGE_GATE_TEXT=本工具面向 18 岁以上用户，请确认年龄。
# 单独明示同意：不得默认勾选、不得捆绑在服务协议中
VITE_FEEDBACK_CONSENT_DEFAULT=false
VITE_FEEDBACK_CONSENT_TEXT=反馈用于角色卡更新
VITE_FEEDBACK_CONSENT_HINT=单独授权 · 默认关闭 · 可随时撤回
VITE_RAW_TEXT_RETENTION_DAYS=7
VITE_DELETE_SLA_HOURS=24
VITE_ANONYMIZE_TEXT=原始文字会匿名处理
VITE_ANONYMIZE_HINT=出结果后就开始倒计时
VITE_CRISIS_HOTLINE_NAME=希望24热线
VITE_CRISIS_HOTLINE_NUMBER=400-161-9995
VITE_CRISIS_RESOURCE_TEXT=如果很难受，请找专业的人聊聊。这里帮不上这个忙。
VITE_COMPLIANCE_GUARD_ENABLED=true
VITE_GUARD_BLOCK_MANIPULATION=true
VITE_GUARD_BLOCK_FATALISM=true
VITE_GUARD_BLOCK_HIGH_RISK=true
# 拦截关键词
VITE_GUARD_MANIPULATION_PATTERNS=让.*爱上|拿捏|操控对方|控制对方|怎么让.*喜欢我|PUA|吊着对方
VITE_GUARD_FATALISM_PATTERNS=没戏了|就是不爱你|注定|没救了|你们完了|不爱你了
VITE_GUARD_HIGH_RISK_PATTERNS=自杀|自残|不想活|伤害自己|活不下去|杀了|轻生
VITE_GUARD_MANIPULATION_NOTICE=这类请求我们不接。请写写你自己的感受和边界。
VITE_GUARD_FATALISM_NOTICE=这里不对关系下结论。怎么做，取决于具体情境。
VITE_GUARD_HIGH_RISK_NOTICE=你写的内容可能需要专业支持。先照顾好自己。
VITE_DISCLAIMER_SHORT=不是心理咨询，也不替你判断关系
VITE_DISCLAIMER_FULL=这里只帮你练怎么开口，不做心理咨询、不判断关系会怎样，也看不到你没贴进来的聊天记录。

# ------------------------------------------------------------------------------
# 08 · 表单选项
# ------------------------------------------------------------------------------
VITE_RELATIONSHIP_TYPES=搭子,初识,轻社交,其他低承诺关系
VITE_FRICTION_EVENT_TYPES=临时取消,热度下降,越界分享,延迟回复
VITE_HESITATION_TYPES=说还是不说,是不是太敏感,值不值得继续,怎么回这条消息
VITE_COMMITMENT_LEVELS=低,中低,中
VITE_BOUNDARY_LEVELS=模糊,一般,清晰
# 这两项会改变等待回复时的感受
VITE_PRIOR_RESPONSIVENESS_LEVELS=通常很快,时快时慢,经常很慢
VITE_MESSAGE_URGENCY_LEVELS=不急,一般,较急
VITE_UNCERTAINTY_SOURCES=自我,对方,关系

# ------------------------------------------------------------------------------
# 09 · 群体页数据
# ------------------------------------------------------------------------------
VITE_GROUP_SAMPLE_SIZE=48
VITE_GROUP_BATCH_LABELS=第 1 批,第 2 批,第 3 批
VITE_GROUP_REPORT_NOTICE=只看整体比例，看不到任何一个人的答案。
VITE_GROUP_DISCUSSION_GUIDE=聊的时候把每种选择当成「当时还能怎么做」，别当成「他是什么样的人」。

# ------------------------------------------------------------------------------
# 10 · 快捷面板（账户 / 付费 / 设置 / 管理）
# ------------------------------------------------------------------------------
VITE_ENABLE_QUICK_PANEL=true
VITE_PANEL_DEFAULT_TAB=0
VITE_PANEL_TRIGGER=账户
VITE_PANEL_TITLE=Account
VITE_PANEL_TABS=账户,付费,设置,管理
VITE_PANEL_SUBTITLE=演示环境 · 数据仅存本地
VITE_PANEL_DISCLAIMER=不是咨询，也不上传你的数据
VITE_PANEL_CLOSE=关闭

# 账户 / 登录
VITE_PANEL_GUEST=未登录
VITE_PANEL_NAME_LABEL=昵称或邮箱
VITE_PANEL_NAME_PLACEHOLDER=给自己起个名字
VITE_PANEL_SIGN_IN=登录 / 注册
VITE_PANEL_SIGN_OUT=退出登录
VITE_PANEL_SIGN_IN_NOTE=演示登录 · 不验证身份 · 不上传信息
VITE_PANEL_PLAN_FREE=免费体验
VITE_PANEL_PLAN_SINGLE=单次解锁
VITE_PANEL_PLAN_SUB=订阅中
VITE_PANEL_ACCOUNT_ARCHIVE=档案
VITE_PANEL_ACCOUNT_PLAN=当前方案

# 付费
VITE_PANEL_SINGLE_TITLE=单次解锁
VITE_PANEL_SINGLE_DESC=一次完整的行动前陪练
VITE_PANEL_SUB_TITLE=月度订阅
VITE_PANEL_SUB_DESC=更多练习与记录
VITE_PANEL_PAY_BUY=解锁
VITE_PANEL_PAY_SUBSCRIBE=订阅
VITE_PANEL_PAY_UNLOCKED=已解锁
VITE_PANEL_PAY_PERIOD=/月
VITE_PANEL_PAY_NOTE=演示付费 · 不产生真实订单

# 设置
VITE_PANEL_SET_FEEDBACK=反馈用于角色卡更新
VITE_PANEL_SET_FEEDBACK_HINT=单独授权 · 默认关闭 · 可撤回
VITE_PANEL_SET_ANONYMIZE=原始文本匿名化
VITE_PANEL_SET_ANONYMIZE_HINT=画像合成后进入删除倒计时
VITE_PANEL_SET_MODE=当前模式
VITE_PANEL_SET_GUARD=安全过滤

# 账户管理
VITE_PANEL_MANAGE_ARCHIVE=档案数
VITE_PANEL_MANAGE_VERSION=角色卡版本
VITE_PANEL_MANAGE_EXPORT=导出 JSON
VITE_PANEL_MANAGE_DELETE=删除全部
VITE_PANEL_MANAGE_DELETE_CONFIRM=确认删除全部本地记录？此操作不可撤销。
VITE_PANEL_MANAGE_DELETE_YES=确认
VITE_PANEL_MANAGE_CANCEL=取消
VITE_PANEL_MANAGE_NOTE=导出在本地生成 · 删除会清空记录

# 陪练页锁定引导（点击直达面板「付费」）
VITE_PANEL_LOCK_TITLE=本次陪练尚未解锁
VITE_PANEL_LOCK_DESC=解锁后就能看到怎么说，以及对方不接怎么办。
VITE_PANEL_LOCK_BUTTON=去解锁 →
