# RFR 服务端配置模板（PRD §9 技术栈）
# 用法：复制为 .env.server 后填写；该文件已被 .gitignore 忽略，切勿提交。
#
# 变量一律不加 VITE_ 前缀：Vite 会把 VITE_* 原样打进浏览器 JS 包，等于公开密钥。
# 前端只请求自己的后端（VITE_API_BASE_URL），由后端持密钥调用模型。
# 留空即降级：没 API key 不调真实模型，没连上 MySQL / Qdrant 服务也能启动自检。

# --- 00 运行 -----------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# 前端 dev server 地址，逗号分隔
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# --- 01 模型：LangChain ChatModel 统一入口 ------------------------------------
# openai-compatible（DashScope 兼容模式）| ollama（本地，无需密钥）
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Supervisor 与 Worker 可分别指定模型 / 温度，不在多处硬编码同一模型
LLM_MODEL_SUPERVISOR=qwen-plus
LLM_MODEL_WORKER=qwen-plus
LLM_TEMPERATURE_SUPERVISOR=0.2
LLM_TEMPERATURE_WORKER=0.7
LLM_TIMEOUT_MS=30000

# Qwen-embedding3：维度必须显式指定，否则 Qdrant collection 维度不匹配
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
# 官方批量上限 20；text-embedding-v3 保守取 10，超出自动分片
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_MS=30000
# sparse 向量不依赖 Qwen，由 FastEmbed 提供
SPARSE_MODEL=Qdrant/bm25

# --- 02 MySQL 8.0.19+ --------------------------------------------------------
# 本地直跑用 127.0.0.1；docker compose 会覆盖为服务名 mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=rfr
MYSQL_PASSWORD=
MYSQL_DATABASE=rfr
MYSQL_POOL_SIZE=5
MYSQL_CONNECT_TIMEOUT_MS=5000

# --- 03 Qdrant ---------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rfr_scenarios
QDRANT_TENANT_FIELD=tenant_id
QDRANT_TIMEOUT_MS=10000

# --- 04 LangGraph / 持久化 Checkpointer --------------------------------------
# 生产禁用 InMemorySaver；首次使用调用 .setup()，手动连接必须 autocommit=True
CHECKPOINTER_ENABLED=true
# CRAG 纠错硬上限，超限降级并标注低置信
LANGGRAPH_MAX_REWRITE=2
LANGGRAPH_THREAD_PREFIX=rfr
LANGGRAPH_SSE_ENABLED=true

# --- 05 可观测 ---------------------------------------------------------------
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rfr-mvp

# --- 06 合规与隐私 -----------------------------------------------------------
GUARD_ENABLED=true
# 硬约束：单独明示授权不得默认勾选，填 true 会被强制回退为 false
FEEDBACK_CONSENT_DEFAULT=false
RAW_TEXT_RETENTION_DAYS=7
DELETE_SLA_HOURS=24
HOTLINE_NAME=希望24热线
HOTLINE_NUMBER=400-161-9995
HIGH_RISK_NOTICE=先照顾好自己，尽快联系专业人士或身边信任的人。

# --- 07 B 端脱敏 -------------------------------------------------------------
# 低于该样本量不返回分布，避免从小样本反推个人
AGGREGATE_MIN_SAMPLE=20
